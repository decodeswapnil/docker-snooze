# Docker Snooze — configuration
# All values are optional; copy to .env and adjust as needed.

# Port the dashboard listens on
PORT=4242

# Secret used to sign session JWTs.
# If unset, a secret is generated on first auth setup and stored in data/auth.json.
# Set this explicitly to keep sessions valid across restarts in a deployment.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
